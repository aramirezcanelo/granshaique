{
  "name": "gran-chaique",
  "version": "1.0.0",
  "main": "dist/server/server.js",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "build:client": "esbuild public/main.ts --bundle --minify --legal-comments=none --format=iife --target=es2020 --outfile=dist/client.js",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run build:server && node --env-file-if-exists=.env dist/server/server.js",
    "check": "npm run build"
  },
  "engines": {
    "node": "22.22.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
