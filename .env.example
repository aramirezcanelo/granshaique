# Requeridos al primer arranque de una instalación de producción sin administrador.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-larga

# Producción activa cookies Secure y exige HTTPS ante el usuario final.
NODE_ENV=production
PORT=8080

# Opcionales; en Render se configuran como /var/data y /var/data/uploads.
# DATA_DIR=
# UPLOADS_DIR=
